# Copy to .env for local `netlify dev`, and set the same vars in the Netlify UI
# (Site settings -> Environment variables) for production.
# NOTE: never put real keys in this tracked file — keep them in .env (gitignored)
# or in the Netlify dashboard.

# --- Required for live gold + crude oil ---
# One free key from Twelve Data covers gold (XAU/USD) and Brent crude.
#   Sign up: https://twelvedata.com/pricing  (free plan)
# Without it, gold & crude fall back to baseline values (the app still runs).
MARKETS_API_KEY=

# --- Optional: more reliable crude ---
# If set, crude is sourced from the EIA (US gov) instead of Twelve Data.
#   Free key: https://www.eia.gov/opendata/register.php
EIA_API_KEY=
